# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────
# Credenciales del contenedor local de MongoDB (docker-compose.yml).
# En un entorno real: secretos del orquestador, nunca en el repo.
MONGO_ROOT_USER=datosapi
MONGO_ROOT_PASSWORD=change_me
MONGO_DB=datosapi
# Puerto publicado en localhost; cambiálo si está ocupado.
MONGO_PORT=27017
MONGODB_URI=mongodb://datosapi:change_me@localhost:27017/datosapi?authSource=admin

# ── Ingesta ──────────────────────────────────────────────────────────
INGEST_TIMEOUT_MS=30000
INGEST_MAX_BYTES=10485760
INGEST_MAX_ROWS=50000
INGEST_USER_AGENT=DatosApi/0.1 (+https://localhost)
STORAGE_DIR=./storage

# ── Endpoint dinámico ────────────────────────────────────────────────
DEFAULT_LIMIT=50
MAX_LIMIT=500
PREVIEW_ROWS=20

# ── Frontend (fase 09, sólo apps/web) ────────────────────────────────
# Va en apps/web/.env.local, NO en el .env de la API.
# NEXT_PUBLIC_* queda embebido en el bundle: nunca un secreto con ese prefijo.
# `pnpm dev` levanta api y web en paralelo; el panel corre en WEB_PORT.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
WEB_PORT=3000
