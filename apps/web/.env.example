# ── Frontend (fase 09) ────────────────────────────────────────────────
# Sólo para apps/web. Copiar a apps/web/.env.local (gitignored).
# El `.env` de la API es otro archivo: esta app no lee MONGODB_URI.
#
# NEXT_PUBLIC_* queda embebido en el bundle del navegador: nunca un secreto
# con ese prefijo. Acá sólo hay una URL pública.
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Puerto del panel en dev y en `next start`. `next.config.ts` y los scripts lo usan.
WEB_PORT=3000