{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^@datosapi/common$": "<rootDir>/../../packages/common/src/index.ts",
    "^@datosapi/database$": "<rootDir>/../../packages/database/src/index.ts"
  }
}
